    <ClCompile Include="src\backend\Arm64Darwin.cpp" />
    <ClCompile Include="src\backend\Emitter.cpp" />
    <ClCompile Include="src\backend\Optimize.cpp" />
    <ClCompile Include="src\backend\Spelling.cpp" />
    <ClCompile Include="src\backend\Tms6747.cpp" />
    <ClCompile Include="src\backend\X86_64.cpp" />
    <ClCompile Include="src\backend\X86_64Linux.cpp" />
    <ClCompile Include="src\backend\X86_64Windows.cpp" />
    <ClCompile Include="src\main.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
