// 7.1: element assignment replaces the row. 5.2: an int widens to a real
// wherever a real is required, "an element of an array literal being fitted
// into a real array" among them.
fun <> = main() {
  real A[2][2]
  A[0] : {1, 2}
  A[1] : {3.5, 4}
  ? A[0][0] A[0][1]
  ? A[1][0] A[1][1]

  // A mixed literal into a real row keeps the fraction.
  A[0] : {7, 2.5}
  ? A[0][0] A[0][1]

  // And an int matrix still takes an int row.
  int B[2][2]
  B[1] : {6, 7}
  ? B[1][0] B[1][1]
}
