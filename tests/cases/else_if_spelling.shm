// A long chain of `else if`, with a bare `else` at the end of it.
//
// The risk in reading two words as one branch is taking the `if` when it is
// not there: a plain `else` must still fall through to its own block rather
// than being swallowed. Four branches then an `else` asks that at length, not
// just once.
fun <> = main() {
  int x
  for x : 0 to 4 {
    if x = 0 {
      ? "zero"
    }
    else if x = 1 {
      ? "one"
    }
    else if x = 2 {
      ? "two"
    }
    else if x = 3 {
      ? "three"
    }
    else {
      ? "many"
    }
  }
  return
}
