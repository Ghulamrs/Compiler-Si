// 7.3 creates a target that does not exist with the output's type. 5.2 makes
// a conversion at a declared destination automatic and silent, and a target
// that already exists is one.

uses sqrt

fun <real> = half(n: int) {
  return n / 2.
}

fun <int, real> = pair() {
  return (7, 2.5)
}

fun <> = main() {
  // Created here, so it is real.
  <a> : half(9)
  ? a

  // Already an int, so the real narrows into it silently.
  int b : 0
  <b> : half(9)
  ? b

  // A builtin, the same way.
  int c : 0
  <c> : sqrt(16.)
  ? c

  // Two outputs, one converted and one not.
  real d : 0.
  int k : 0
  <d, k> : pair()
  ? d k
}
