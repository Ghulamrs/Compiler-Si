// prime.shm
// Two outputs: the remainder and the
// factor that produced it.

uses sqrt, ceil

fun <int,int> = prime(n: int) {
   int i : 2
   int m : 1
   if n < 2 { return (0, n) }
   if n > 2 { m : n%i }
   if m = 0 { return (m, i) }
   q : ceil(sqrt(n))
   for j:3 to q step 2 {
      m : n%j
      if m = 0 { return (m, j) }
   }
   return (m, i)
}

fun <> = main() {
   for j:1301 to 1350 step 2 {
      <d,k> : prime(j)
      if d = 0 {
         ? j "has factor" k
      }
      else {
         ? j "is a prime"
      }
   }
}
// expected: 1301 is a prime
// expected: 1303 is a prime
// expected: 1305 has factor 3
